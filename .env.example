# ============================================================
#  .env.example — Variáveis de ambiente do Sistema de Inventário TI
#
#  INSTRUÇÕES:
#  1. Copie este arquivo para .env:
#       cp .env.example .env
#  2. Preencha os valores com as credenciais reais.
#  3. NUNCA commite o arquivo .env no repositório.
#
#  O arquivo .env deve estar no gitignore:
#       echo ".env" >> .gitignore
# ============================================================

# ── Supabase / PostgreSQL ─────────────────────────────────────
# Connection string do Supabase (Direct Connection, porta 5432)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
SUPABASE_DATABASE_URL=postgresql://postgres:SUA_SENHA_AQUI@db.SEU_PROJETO.supabase.co:5432/postgres

# ── Flask (opcional) ─────────────────────────────────────────
# Chave secreta para sessões Flask (gere com: python -c "import secrets; print(secrets.token_hex())")
FLASK_SECRET_KEY=troque-por-uma-chave-secreta-aleatoria

# ── Ambiente ──────────────────────────────────────────────────
# 'development' habilita debug; 'production' desabilita
FLASK_ENV=production
