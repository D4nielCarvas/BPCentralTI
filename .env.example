# ============================================================
#  .env.example - Variaveis de ambiente do Sistema de Inventario TI
#
#  INSTRUCOES:
#  1. Copie este arquivo para .env:
#       copy .env.example .env
#  2. Preencha os valores com as credenciais reais.
#  3. NUNCA commite o arquivo .env no repositorio.
# ============================================================

# ── Supabase / PostgreSQL ──────────────────────────────────────
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
SUPABASE_DATABASE_URL=postgresql://postgres:SUA_SENHA@db.SEU_PROJETO.supabase.co:5432/postgres

# ── Flask ──────────────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-secreta-aleatoria

# ── Ambiente ───────────────────────────────────────────────────
FLASK_ENV=production

# ── E-mail / SMTP (Recuperacao de Senha) ──────────────────────
# Zoho Pro (porta 465 SSL):
#   SMTP_HOST=smtppro.zoho.com  |  SMTP_PORT=465
# Outlook 365 (porta 587 STARTTLS):
#   SMTP_HOST=smtp.office365.com  |  SMTP_PORT=587
# Gmail (porta 587 + App Password):
#   SMTP_HOST=smtp.gmail.com  |  SMTP_PORT=587
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_USER=seuemail@suaempresa.com.br
SMTP_PASSWORD=SUA_SENHA_EMAIL_AQUI
# Nota: a URL do sistema e detectada automaticamente pelo Flask.
# Nao e necessario configurar APP_BASE_URL.
